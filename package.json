{
  "name": "palm-qr-attendance",
  "version": "2.3.0",
  "private": true,
  "description": "Palm and QR attendance app with offline records and encrypted palm registration transfer",
  "scripts": {
    "android:sync": "npx cap sync android",
    "android:debug": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:palm": "esbuild www/palm-engine.js --bundle --format=iife --outfile=www/palm-engine.bundle.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.2",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "3.11.174",
    "@mediapipe/tasks-vision": "0.10.14",
    "onnxruntime-web": "1.20.1"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  }
}
